{
  "name": "@interop/security-document-loader",
  "description": "A secure and convenient JSON-LD document loader for Node.js, browsers, and React Native.",
  "version": "10.0.2",
  "type": "module",
  "scripts": {
    "build": "pnpm run clear && tsc",
    "clear": "rimraf dist/*",
    "dev": "vite",
    "fix": "eslint --fix src test && pnpm run format",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint src test",
    "prepare": "pnpm run build",
    "rebuild": "pnpm run clear && pnpm run build",
    "test": "pnpm run fix && pnpm run test-node && pnpm run test-browser",
    "test-browser": "playwright test",
    "test-node": "vitest run",
    "test-coverage": "vitest run --coverage"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "module": "dist/index.js",
  "browser": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "dependencies": {
    "@digitalbazaar/data-integrity-context": "^2.0.1",
    "@digitalbazaar/multikey-context": "^2.0.1",
    "@digitalbazaar/vc-bitstring-status-list-context": "^1.1.0",
    "@digitalbazaar/vc-status-list-context": "^3.1.1",
    "@digitalbazaar/zcap-context": "^2.0.1",
    "@digitalcredentials/credentials-v2-context": "^1.0.0",
    "@digitalcredentials/open-badges-context": "^3.0.0",
    "@interop/data-integrity-core": "^8.7.1",
    "@interop/did-io": "^4.1.1",
    "@interop/did-method-key": "^7.3.5",
    "@interop/did-web-resolver": "^6.3.0",
    "@interop/ecdsa-multikey": "^2.3.3",
    "@interop/ed25519-verification-key": "^8.0.4",
    "@interop/http-client": "^1.0.5",
    "aes-key-wrapping-2019-context": "^1.0.3",
    "credentials-context": "^2.0.0",
    "did-context": "^3.1.1",
    "ed25519-signature-2020-context": "^1.1.0",
    "html-entities": "^2.6.0",
    "jsonld-document-loader": "^2.3.0",
    "sha256-hmac-key-2019-context": "^1.0.3",
    "x25519-key-agreement-2020-context": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24.0"
  },
  "author": {
    "name": "Interop Alliance",
    "url": "https://github.com/interop-alliance/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/interop-alliance/security-document-loader"
  },
  "homepage": "https://github.com/interop-alliance/security-document-loader",
  "bugs": "https://github.com/interop-alliance/security-document-loader/issues"
}
